      <aliases enabled='yes' />
      <column datatype='string' name='[Body Style]' role='dimension' type='nominal' />
      <column caption='Body Style % Of Total' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0421719379513345] / TOTAL([Calculation_0421719379513345])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue' datatype='integer' name='[Calculation_0421719379316736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Price ($)])' />
      </column>
      <column caption='Cars Sold' datatype='integer' name='[Calculation_0421719379513345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Car_id])' />
      </column>
      <column caption='Average Car price ' datatype='real' name='[Calculation_0421719380180994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Price ($)])' />
      </column>
      <column caption='Income Group ' datatype='string' name='[Calculation_0421719381237763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Annual Income] &lt; 30000 THEN &quot;Low Income&quot;&#13;&#10;ELSEIF [Annual Income] &lt; 70000 THEN &quot;Middle Income&quot;&#13;&#10;ELSE &quot;High Income&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Sale Year ' datatype='integer' name='[Calculation_0421719381803012]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([Date])' />
      </column>
      <column caption='Sale Quarter' datatype='string' name='[Calculation_0421719381884933]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [Date]))' />
      </column>
      <column aggregation='Sum' caption='Sale Month ' datatype='integer' name='[Calculation_0421719381999622]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [Date])' />
      </column>
      <column caption='Sale Category' datatype='string' name='[Calculation_0421719899648009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price ($)] &gt; 30000 THEN &quot;Premium Sale&quot;&#13;&#10;ELSE &quot;Standard Sale&quot;&#13;&#10;END' />
      </column>
      <column caption='Dealer Rank' datatype='integer' name='[Calculation_0421719903121419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Price ($)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N Filter' datatype='boolean' name='[Calculation_0421719903293452]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0421719903121419] &lt;= [Parameters].[Parameter 0421719902179338]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Model Rank' datatype='integer' name='[Calculation_0421721630097421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK([Calculation_0421719379513345])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top 10 Models Filter' datatype='boolean' name='[Calculation_0421721630216206]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0421721630097421]&lt;=10'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Engine Clean' datatype='string' name='[Calculation_0768608936427520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Engine], &quot;Double&quot;) THEN &quot;Double Overhead Camshaft&quot;&#13;&#10;   ELSE &quot;Overhead Camshaft&quot;&#13;&#10;   END' />
      </column>
      <column caption='Car id' datatype='string' name='[Car_id]' role='dimension' type='nominal' />
